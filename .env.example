# Protected dashboard. The defaults are suitable only for local development.
DASHBOARD_USER=admin
DASHBOARD_PASS=admin123
HOST=127.0.0.1
PORT=3000

# Panel credentials are added through the protected "Add Server details" dashboard form
# and stored in SQLite. These legacy variables are imported once only when the server
# database has no configured servers; omit them for a new multi-server installation.
# THREEXUI_BASE_URL=https://panel.example.com/your-panel-prefix
# THREEXUI_BEARER_TOKEN=replace-with-panel-bearer-token
# THREEXUI_USERNAME=replace-with-panel-username
# THREEXUI_PASSWORD=replace-with-panel-password
# This optional code is used for every configured panel whose login needs 2FA.
THREEXUI_TWO_FACTOR_CODE=
THREEXUI_TIMEOUT_MS=10000

# Telegram notification delivery. Use a dedicated bot that is NOT the bot
# connected to 3X-UI (for example, cus_noti_bot rather than kre_az_bot).
# The notification bot must be started once by every recipient before it can DM them.
NOTIFICATION_TELEGRAM_BOT_TOKEN=replace-with-cus-noti-bot-token
# Reply to private /start messages with the linked VLESS account details. Only
# run one application instance for this bot; long polling conflicts with webhooks.
TELEGRAM_WELCOME_ENABLED=true

# Standard five-field cron expression. Defaults to every two minutes.
CHECK_INTERVAL_CRON=*/2 * * * *
